# IReckon 环境变量示例 — 复制为 .env 并填入真实值
# 参考: config/config.yaml 中的 ai_pool.instances

# DeepSeek 官方 API Key (deepseek-v4-flash / deepseek-v4-pro)
DEEPSEEK_API_KEY=sk-xxx

# OpenCode Zen 网关 Key (免费模型: x-preview-f-free / big-pickle / deepseek-v4-flash-free 等)
OPENCODE_API_KEY=

# FreeLLM API Key (本地/自建 OpenAI 兼容端点)
FREELMAPI_KEY=

# API 访问令牌（可选安全配置）：配置后所有 /api/* 接口与 /ws* WebSocket
# 握手都必须携带令牌（HTTP 用 X-API-Token 头，WebSocket 用 ?token= 查询参数）。
# 未配置时仅允许本机回环访问；/api/self-improve 与 /api/update/apply 等
# 高危端点则必须配置令牌后才能调用。
# 也可在 config/config.yaml 的 security.api_token 中配置，环境变量优先。
IRECKON_API_TOKEN=

# 运行时根目录（可选覆盖；host/port 在 config/config.yaml 的 server 段配置）
# IRECKON_HOME=.

# 开发模式: 用独立 Vite dev server 提供前端 (cd frontend && npm run dev)
# IRECKON_DEV_FRONTEND=1

# 日志着色 (可选: 1 开启 / 0 关闭)
# IRECKON_LOG_COLOR=1